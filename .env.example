# Copy this file to .env.local and fill in your Firebase Web App credentials.
# NEVER commit .env.local or real API keys to GitHub.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase App Check (supports 'v3' or 'enterprise')
VITE_APP_CHECK_PROVIDER=enterprise
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_site_key

# Optional: Enable App Check debug token in local development ONLY
VITE_APP_CHECK_DEBUG_TOKEN=false
