rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Field allowlist (not a blocklist): a renamed raw field such as "rawTxt" can never slip through.
    function validSession(d) {
      return d.keys().hasOnly([
          'id', 'uid', 'title', 'category', 'documentCount', 'sanitizedExcerpts',
          'zeroLeakProofHash', 'triage', 'deepAudit', 'updatedAt'
        ])
        && d.uid == request.auth.uid
        && d.id is string && d.id.size() <= 80
        && d.title is string && d.title.size() <= 200
        && d.category in ['contract', 'medical', 'financial', 'custom']
        && d.documentCount is int && d.documentCount >= 1 && d.documentCount <= 12
        && d.sanitizedExcerpts is list && d.sanitizedExcerpts.size() <= 12
        && d.zeroLeakProofHash is string && d.zeroLeakProofHash.size() <= 80
        && d.updatedAt is string && d.updatedAt.size() <= 40
        && (!('triage' in d) || d.triage is map)
        && (!('deepAudit' in d) || d.deepAudit is map);
    }

    // Strictly isolate sanitized Zero-PII audit sessions per Firebase Auth UID
    match /sanitized_sessions/{sessionId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.id == sessionId
        && validSession(request.resource.data);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validSession(request.resource.data);
    }

    // The code identifies a relay. Its owner must approve the recipient separately.
    match /relays/{code} {
      function validFlag(flag) {
        return flag is map && flag.keys().hasOnly(['title', 'severity', 'summary'])
          && flag.title is string && flag.title.size() > 0 && flag.title.size() <= 120
          && flag.severity in ['high', 'medium', 'low']
          && flag.summary is string && flag.summary.size() > 0 && flag.summary.size() <= 1200;
      }
      function validFlags(flags) {
        return flags is list && flags.size() <= 5
          && (flags.size() < 1 || validFlag(flags[0]))
          && (flags.size() < 2 || validFlag(flags[1]))
          && (flags.size() < 3 || validFlag(flags[2]))
          && (flags.size() < 4 || validFlag(flags[3]))
          && (flags.size() < 5 || validFlag(flags[4]));
      }
      allow create: if request.auth != null && code.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt','expiresAt','flags','emailSanitized'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
        && request.resource.data.emailSanitized is string
        && request.resource.data.emailSanitized.size() > 0
        && request.resource.data.emailSanitized.size() <= 5000
        && validFlags(request.resource.data.flags);
      function relay() {
        return get(/databases/$(database)/documents/relays/$(code)).data;
      }
      function isOwner() {
        return request.auth != null && relay().ownerUid == request.auth.uid;
      }
      function live() {
        return code.matches('[0-9]{6}') && request.time < relay().expiresAt;
      }
      function approvedReceiver() {
        return get(/databases/$(database)/documents/relays/$(code)/pairing/approval).data.receiverUid == request.auth.uid;
      }
      allow get: if request.auth != null && code.matches('[0-9]{6}') && request.time < resource.data.expiresAt
        && (resource.data.ownerUid == request.auth.uid || approvedReceiver());

      match /requests/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid && live() && !isOwner()
          && request.resource.data.keys().hasOnly(['challenge', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.challenge is string
          && request.resource.data.challenge.matches('[0-9]{6}');
        allow get: if request.auth != null && live() && (request.auth.uid == uid || isOwner());
        allow list: if isOwner() && live() && request.query.limit <= 2;
      }
      match /pairing/approval {
        allow create: if isOwner() && live()
          && request.resource.data.keys().hasOnly(['receiverUid','challenge','approvedAt'])
          && request.resource.data.approvedAt == request.time
          && request.resource.data.receiverUid is string
          && request.resource.data.receiverUid.matches('[A-Za-z0-9_-]{1,128}')
          && get(/databases/$(database)/documents/relays/$(code)/requests/$(request.resource.data.receiverUid)).data.challenge
             == request.resource.data.challenge;
        allow get: if isOwner() && live();
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
