{
  "manifest_version": 3,
  "name": "VeilBench Selection",
  "version": "1.0.0",
  "description": "Open selected text in the VeilBench privacy airlock.",
  "key": "", // gitleaks:allow -- Chrome extension ID, public RSA SPKI (not a credential)
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": ["https://veilbench-hybrid-ai.web.app/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://veilbench-hybrid-ai.web.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://veilbench-hybrid-ai.web.app/*"
    ]
  }
}
